{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n home,admin,student,tutor -c blue,green,yellow,magenta \"npm run dev --prefix home\" \"npm run dev --prefix admin\" \"npm run dev --prefix student\" \"npm run dev --prefix tutor\"",
    "dev:root": "vite",
    "dev:admin": "npm run dev --prefix admin",
    "dev:student": "npm run dev --prefix student",
    "dev:tutor": "npm run dev --prefix tutor",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "install:all": "npm install && npm install --prefix admin && npm install --prefix student && npm install --prefix tutor"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "axios": "^1.18.1",
    "face-api.js": "^0.22.2",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.24.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.4",
    "concurrently": "^9.1.2",
    "oxlint": "^1.71.0",
    "postcss": "^8.5.21",
    "tailwindcss": "^4.3.3",
    "vite": "^8.1.1"
  }
}
